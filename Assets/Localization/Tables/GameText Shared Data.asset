    - rid: 221144893936369783
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Settings: help line shown when no setting is hovered.'
    - rid: 221144893936369784
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Settings row title: game language. Keep " / Language" after
          the translated word so players stuck in a language they cannot read can
          still find it (in English write only "Language").'
