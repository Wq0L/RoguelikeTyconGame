      m_Items: []
  - m_Id: 227725751898123
    m_Localized: "\xF6n ko\u015Ful: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898124
    m_Localized: "Se\xE7ince konumunu sen belirlersin"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898125
    m_Localized: "Bunu al\u0131rsan {0} bir daha sunulmaz"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898126
    m_Localized: "Ayn\u0131 anda kas\u0131rga / bumerang (her biri): {0} \u2192 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898127
    m_Localized: "Kas\u0131rga / bumerang aktif s\u0131n\u0131r\u0131 +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898128
    m_Localized: "Gelecekteki her seviye: {0} \u2192 {1} se\xE7im"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898129
    m_Localized: "Seviye se\xE7imi {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898130
    m_Localized: "seviye ba\u015F\u0131na se\xE7im {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898131
    m_Localized: "\xD6nceden kazan\u0131lm\u0131\u015F se\xE7imler de\u011Fi\u015Fmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898132
    m_Localized: "kazan\xE7: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898133
    m_Localized: 'bedel: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898134
    m_Localized: "Seviye ba\u015F\u0131na se\xE7im: {0} (normalde {1}). Bundan sonra
      kazan\u0131lan seviyelerde ge\xE7erli."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898135
    m_Localized: "{0} A\u015EAMA \xB7 SINAMA \xD6D\xDCL\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898136
    m_Localized: "{0} A\u015EAMA \xB7 {1}. turdaki S\u0131namadan itibaren"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898137
    m_Localized: "{0} A\u015EAMA"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898138
    m_Localized: "Uygun \xF6d\xFCl kalmad\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898139
    m_Localized: "\xD6d\xFCllerin hepsi ya al\u0131nd\u0131 ya da \u015Fu an i\u015Fe
      yaram\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898140
    m_Localized: DEVAM
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898141
    m_Localized: "SINAMA GE\xC7\u0130LD\u0130 \xB7 \xD6D\xDCL SE\xC7"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898142
    m_Localized: "SON SINAMA GE\xC7\u0130LD\u0130 \xB7 \xD6D\xDCL SE\xC7"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898143
    m_Localized: "Bu S\u0131nama i\xE7in sunulabilecek \xF6d\xFCl yok"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898144
    m_Localized: "Birini se\xE7. {0}. turdan itibaren deneme sonuna kadar ge\xE7erli."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898145
    m_Localized: "Birini se\xE7. {0}. turdan itibaren deneme sonuna kadar ge\xE7erli."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898146
    m_Localized: "Birini se\xE7. Deneme burada bitiyor, \xF6d\xFCl sonu\xE7 ekran\u0131na
      yaz\u0131l\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898147
    m_Localized: "Birini se\xE7. Deneme burada bitiyor, \xF6d\xFCl sonu\xE7 ekran\u0131na
      yaz\u0131l\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898148
    m_Localized: "S\u0131namay\u0131 ge\xE7tin. {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898149
    m_Localized: "Son S\u0131namay\u0131 ge\xE7tin. {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898150
    m_Localized: "KAZAN\xC7"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898151
    m_Localized: BEDEL
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898152
    m_Localized: "\u015Eu an {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898153
    m_Localized: "\u015Eu an {0}/{1}: toplam {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898154
    m_Localized: "\u015Eu an 0/{0}: yok"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898155
    m_Localized: "Se\xE7ince {0}/{1}: toplam {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898156
    m_Localized: "Al\u0131nan S\u0131nama \xF6d\xFClleri"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898157
    m_Localized: "ANTEN\u0130 YERLE\u015ET\u0130R"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898158
    m_Localized: "Tarlan\u0131n kenar\u0131nda bir yer se\xE7. Anten tarlaya do\u011Fru
      bakar."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898159
    m_Localized: "{1} sn'de bir, bakt\u0131\u011F\u0131 y\xF6ndeki ilk {0} h\xFCcreye
      hasat hasar\u0131n\u0131n %{2}'i kadar vurur"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898160
    m_Localized: "hat, davran\u0131\u015F\u0131 olan bir saks\u0131n\u0131n bitkisini
      hasat ederse o saks\u0131n\u0131n \u015Fans\u0131yla bir kez daha vurur (hasar\u0131n
      %{0}'i, {1} sn bekleme)"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898161
    m_Localized: "\u0130K\u0130NC\u0130 ANTEN"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898162
    m_Localized: "\u0130lk antenle ayn\u0131 hizada, kar\u015F\u0131 kenara yerle\u015Fir"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898163
    m_Localized: "kar\u015F\u0131 kenara, ayn\u0131 hizaya ikinci bir anten kurulur.
      \u0130ki anten aras\u0131ndaki h\xFCcrelere {0} sn'de bir, hasat hasar\u0131n\u0131n
      %{1}'i kadar vurur"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898164
    m_Localized: "her {0} do\u011Frudan isabette imle\xE7ten bir hilal f\u0131rlar.
      Rastgele bir y\xF6ne en fazla {1} birim gider, hasat hasar\u0131n\u0131n %{2}'i
      kadar vurur"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898165
    m_Localized: "her {0} vuru\u015Fta bir hilal f\u0131rlar. {1} h\xFCcre gider,
      hasat hasar\u0131n\u0131n %{2}'i kadar vurur"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898166
    m_Localized: "kritik vuru\u015F, {0} h\xFCcre yak\u0131ndaki ba\u015Fka bir bitkiye
      s\u0131\xE7rar. Kritik hasar\u0131n %{1}'i kadar vurur, vuru\u015F ba\u015F\u0131na
      en fazla {2} kez"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898167
    m_Localized: "tek vuru\u015Fta {0} ya da daha fazla bitkiye kritik yaparsan ortada
      bir alan vuru\u015Fu daha patlar. G\xFCc\xFC: hasat hasar\u0131 \xD7 kritik
      \xE7arpan\u0131n\u0131n %{1}'i"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898168
    m_Localized: "her ana hilalle birlikte imle\xE7 halkas\u0131ndan b\xFCy\xFCk
      bir hilal daha \xE7\u0131kar ve ba\u015Fka bir y\xF6ne gider. Taban hasar\u0131n
      %{0}'i kadar vurur. Kar\u015F\u0131l\u0131\u011F\u0131nda vuru\u015Flar\u0131n
      {1} sn durur"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898169
    m_Localized: "tek vuru\u015Fta {0} ya da daha fazla bitki hasat edersen s\u0131radaki
      vuru\u015Fun \xD7{1} hasar verir. Tek bitkiye vurursan bu hak kaybolur"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898170
    m_Localized: "hilal {0} birim daha uza\u011Fa gider. Hasat ettik\xE7e b\xFCy\xFCr:
      her seferinde hasar\u0131 %{1} artar (en fazla {2} kez), \xF6n\xFC {3} h\xFCcre
      geni\u015Fler. Hasat etmeden ge\xE7en bir ad\u0131m b\xFCy\xFCmeyi s\u0131f\u0131rlar"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898171
    m_Localized: "tek vuru\u015Fta {0} ya da daha fazla hasat yaparsan, kesti\u011Fin
      h\xFCcrelerin, tarlan\u0131n ortas\u0131na g\xF6re tam kar\u015F\u0131s\u0131na
      g\xF6kta\u015F\u0131 d\xFC\u015Fer (en fazla {1} h\xFCcre). Hasat hasar\u0131n\u0131n
      %{2}'i kadar vurur, {3} sn bekleme"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898172
    m_Localized: "\xF6ld\xFCren vuru\u015Ftan artan hasar\u0131n %{0}'i yandaki bitkiye
      ge\xE7er. En fazla {1} kez aktar\u0131l\u0131r, her seferinde %{2} azal\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898173
    m_Localized: "tetiklenen bir saks\u0131 davran\u0131\u015F\u0131 {0} sn sonra,
      hasar\u0131n %{1}'i kadar bir kez daha \xE7al\u0131\u015F\u0131r. Ayn\u0131
      saks\u0131 ve davran\u0131\u015F i\xE7in {2} sn bekleme var"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898174
    m_Localized: "{0} ya da daha nadir bir bitkiyi kendi vuru\u015Funla hasat edince
      davran\u0131\u015F \u015Fanslar\u0131n {1} sn boyunca \xD7{2} olur. \xDCst
      \xFCste binmez, s\xFCre ba\u015Ftan ba\u015Flar"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898175
    m_Localized: "{0} \xB7 t\u0131kla: yerle\u015Ftir \xB7 {1}: vazge\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898176
    m_Localized: "VAZGE\xC7"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898177
    m_Localized: SINIRSIZ
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898178
    m_Localized: Hasattan gelen TP.
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898179
    m_Localized: "Sadece kendi vuru\u015Funu etkiler. Bir kez al\u0131nabilir."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898180
    m_Localized: "Bir kez al\u0131nabilir. Vuru\u015F aras\u0131 0,10 saniyenin alt\u0131na
      inmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898181
    m_Localized: "Bir zincirde her saks\u0131n\u0131n davran\u0131\u015F\u0131 en
      fazla bir kez tetiklenir. Art\xE7\u0131 ve ikinci dalga zincire kat\u0131lmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898182
    m_Localized: Hasat Ritmi
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898183
    m_Localized: 'Ritim:'
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898184
    m_Localized: "Sadece kendi vuru\u015Funla yapt\u0131\u011F\u0131n hasatlar say\u0131l\u0131r.
      Saya\xE7 dolunca s\u0131radaki vuru\u015Fun g\xFC\xE7lenir ve imle\xE7 halkas\u0131
      b\xFCy\xFCr. Ek vuru\u015F \xE7\u0131karmaz, davran\u0131\u015Flar\u0131 etkilemez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898185
    m_Localized: Zincir Hasat
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898186
    m_Localized: 'Zincir:'
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898187
    m_Localized: "Bol Se\xE7enek"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898188
    m_Localized: "Davran\u0131\u015F hasar\u0131 de\u011Fi\u015Fmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898189
    m_Localized: "Saks\u0131lara G\xFCven"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898190
    m_Localized: "Patlama, elektrik, kas\u0131rga ve bumerang\u0131 g\xFC\xE7lendirir.
      Kendi vuru\u015Fun de\u011Fi\u015Fmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898191
    m_Localized: "A\u011F\u0131r Darbe"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898192
    m_Localized: "Kritik hasar \xE7arpan\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898193
    m_Localized: "Sadece kendi vuru\u015Funun kritiklerini g\xFC\xE7lendirir."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898194
    m_Localized: "Nadir Avc\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898195
    m_Localized: "Nadir ve \xFCst\xFC bitkiye do\u011Frudan hasar"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898196
    m_Localized: "Sadece kendi vuru\u015Funu etkiler. S\u0131radan ve Seyrek bitkiler
      ile davran\u0131\u015F hasar\u0131 de\u011Fi\u015Fmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898197
    m_Localized: Bereketli Toprak
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898198
    m_Localized: "\xDCretim aral\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898199
    m_Localized: "\xFCretim s\u0131kl\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898200
    m_Localized: "B\xFCt\xFCn saks\u0131larda ge\xE7erli. Sadece tarlan bo\u015F
      kal\u0131yorsa \xE7\u0131kar. \xDCretim s\xFCresi 0,50 saniyenin alt\u0131na
      inmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898201
    m_Localized: "Tecr\xFCbe Tohumu"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898202
    m_Localized: "Kazan\u0131lan TP"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898203
    m_Localized: "Hasattan gelen TP. 30. turdaki S\u0131namadan sonra \xE7\u0131kmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898204
    m_Localized: "Dev T\u0131rpan"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898205
    m_Localized: "Do\u011Frudan vuru\u015F hasar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898206
    m_Localized: "Sadece kendi vuru\u015Funu etkiler. 25. turdaki S\u0131namadan
      sonra \xE7\u0131kar, bir kez al\u0131nabilir."
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898207
    m_Localized: "\xC7evik Bilek"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898208
    m_Localized: "Sald\u0131r\u0131 aral\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898209
    m_Localized: "sald\u0131r\u0131 s\u0131kl\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092416
    m_Localized: "25. turdaki S\u0131namadan sonra \xE7\u0131kar, bir kez al\u0131nabilir.
      Vuru\u015F aras\u0131 0,10 saniyenin alt\u0131na inmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092417
    m_Localized: "Geni\u015F Savuru\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092418
    m_Localized: "Vuru\u015F yar\u0131\xE7ap\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092419
    m_Localized: "Sadece kendi vuru\u015Funu etkiler: imle\xE7 halkas\u0131 b\xFCy\xFCr.
      Davran\u0131\u015Flar\u0131n alan\u0131 de\u011Fi\u015Fmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092420
    m_Localized: "H\u0131zl\u0131 Bilek"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092421
    m_Localized: "Sald\u0131r\u0131 aral\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092422
    m_Localized: "sald\u0131r\u0131 s\u0131kl\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092423
    m_Localized: "Vuru\u015Flar\u0131n aras\u0131 k\u0131sal\u0131r, ama 0,10 saniyenin
      alt\u0131na inmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092424
    m_Localized: "Keskin B\u0131\xE7ak"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092425
    m_Localized: "Do\u011Frudan vuru\u015F hasar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092426
    m_Localized: "Sadece kendi vuru\u015Funu g\xFC\xE7lendirir. Davran\u0131\u015F
      hasar\u0131 de\u011Fi\u015Fmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092427
    m_Localized: Kolay Tetik
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092428
    m_Localized: "Mevcut davran\u0131\u015F \u015Fanslar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092429
    m_Localized: "Patlama, kas\u0131rga, bumerang ve elektrik \u015Fans\u0131n\u0131
      art\u0131r\u0131r. \u015Eans\u0131 hi\xE7 olmayan saks\u0131ya \u015Fans vermez.
      En fazla %100."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092430
    m_Localized: "Kritik G\xF6z"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092431
    m_Localized: "Kritik \u015Fans\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092432
    m_Localized: "Sadece kendi vuru\u015Funu etkiler. \u015Eansa y\xFCzde puan olarak
      eklenir."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092433
    m_Localized: Nadir Tohum
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092434
    m_Localized: Nadirlik bonusu
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092435
    m_Localized: "B\xFCt\xFCn saks\u0131larda ge\xE7erli. Y\xFCzde puan olarak eklenir,
      en fazla 95 puan."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092436
    m_Localized: "G\xFC\xE7l\xFC Saks\u0131lar"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092437
    m_Localized: "Davran\u0131\u015F hasar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092438
    m_Localized: "Patlama, kas\u0131rga, bumerang ve elektri\u011Fi g\xFC\xE7lendirir.
      Kendi vuru\u015Fun de\u011Fi\u015Fmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092439
    m_Localized: "A\xE7g\xF6zl\xFC Hasat"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092440
    m_Localized: "A\xE7g\xF6zl\xFCl\xFCk:"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092441
    m_Localized: "Bo\u015Fa savurmak hakk\u0131 harcamaz. G\xFC\xE7lenmi\u015F vuru\u015F
      yeni hak kazand\u0131rmaz. Davran\u0131\u015Flar\u0131 etkilemez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092442
    m_Localized: "\xC7ifte Tetik"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092443
    m_Localized: 'Tekrar:'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092444
    m_Localized: "Tekrar eden davran\u0131\u015F zincir ba\u015Flatmaz, yeni \u015Fans
      da atmaz. Ayn\u0131 anda olabilecek kas\u0131rga ve bumerang say\u0131s\u0131
      a\u015F\u0131lmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092445
    m_Localized: "B\xFCy\xFCyen Ay"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092446
    m_Localized: "B\xFCy\xFCme:"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092447
    m_Localized: "Hilal 3 yerine 4 birim gider ve ilerledik\xE7e b\xFCy\xFCr. Hasar\u0131
      ise sadece ger\xE7ekten hasat ettik\xE7e artar. Dolunay ba\u015Ftan b\xFCy\xFCkt\xFCr,
      b\xFCy\xFCmez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092448
    m_Localized: Dolunay
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092449
    m_Localized: 'Dolunay:'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092450
    m_Localized: "Her ana hilalle birlikte b\xFCy\xFCk bir hilal daha \xE7\u0131kar,
      hasat \u015Fart\u0131 yok. \u0130mle\xE7 halkas\u0131ndan ba\u015Fka bir y\xF6ne
      gider. Dolunaydan yeni Dolunay \xE7\u0131kmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092451
    m_Localized: Elektrik Anteni
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092452
    m_Localized: 'Anten:'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092453
    m_Localized: "Anten tarlan\u0131n kenar\u0131nda durur, saks\u0131lara yer kaplamaz.
      Vuru\u015Fu senin vuru\u015Fun say\u0131lmaz: kritik yapmaz, davran\u0131\u015F
      tetiklemez."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092454
    m_Localized: "Ayna G\xF6kta\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092455
    m_Localized: "G\xF6kta\u015F\u0131:"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092456
    m_Localized: "Sadece kendi vuru\u015Funla yapt\u0131\u011F\u0131n hasatlar say\u0131l\u0131r.
      G\xF6kta\u015F\u0131ndan yeni g\xF6kta\u015F\u0131 \xE7\u0131kmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092457
    m_Localized: Hilal
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092458
    m_Localized: 'Hilal:'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092459
    m_Localized: "Hilal, imle\xE7 halkas\u0131n\u0131n kenar\u0131ndan rastgele bir
      y\xF6ne f\u0131rlar. Normalde 3 birim gider, B\xFCy\xFCyen Ay ile 4."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092460
    m_Localized: "\u0130letken Hat"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092461
    m_Localized: 'Hat:'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092462
    m_Localized: "\u0130kinci antenin yerini sen se\xE7ersin. Hat kurulamayan yerler
      se\xE7ilemez. Hat vuru\u015Fu senin vuru\u015Fun say\u0131lmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092463
    m_Localized: "Kapal\u0131 Devre"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092464
    m_Localized: 'Devre:'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092465
    m_Localized: "Ek hat vuru\u015Fu yeni ek vuru\u015F ba\u015Flatmaz. Davran\u0131\u015F\u0131
      olan saks\u0131 yoksa i\u015Fe yaramaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092466
    m_Localized: "S\u0131\xE7rayan Kritik"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092467
    m_Localized: "S\u0131\xE7rama:"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092468
    m_Localized: "Kritik, vuru\u015Funun de\u011Fmedi\u011Fi bir bitkiye s\u0131\xE7rar.
      S\u0131\xE7rayan vuru\u015F kritik yapmaz, yeniden s\u0131\xE7ramaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092469
    m_Localized: "Nadir Heyecan\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092470
    m_Localized: 'Heyecan:'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092471
    m_Localized: "Patlama, kas\u0131rga, bumerang ve elektrik \u015Fans\u0131n\u0131
      art\u0131r\u0131r. \u015Eans\u0131 hi\xE7 olmayan saks\u0131ya \u015Fans vermez.
      En fazla %100."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092472
    m_Localized: "Ta\u015Fan Hasar"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092473
    m_Localized: "Ta\u015Fma:"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092474
    m_Localized: "Sadece kendi vuru\u015Funla \xF6ld\xFCrd\xFC\u011F\xFCn bitkiden
      ba\u015Flar. Aktar\u0131lan hasar kritik yapmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092475
    m_Localized: "Art\xE7\u0131 Patlama"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092476
    m_Localized: "Art\xE7\u0131 patlama:"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092477
    m_Localized: "Patlaman\u0131n d\u0131\u015F kenar\u0131ndan \xFC\xE7 ad\u0131m
      yay\u0131l\u0131r. Her h\xFCcreye bir kez vurur, kilitli h\xFCcrelerden ge\xE7mez.
      Art\xE7\u0131dan yeni art\xE7\u0131 ya da zincir \xE7\u0131kmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092478
    m_Localized: "\xC7ifte Ak\u0131m"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092479
    m_Localized: "\u0130kinci elektrik dalgas\u0131:"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092480
    m_Localized: "\u015Eans\u0131 tutan her elektrikten sonra ayn\u0131 saks\u0131dan
      ikinci bir dalga \xE7\u0131kar. Bunun i\xE7in yeni \u015Fans at\u0131lmaz,
      ikinci dalga zincir ba\u015Flatmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092481
    m_Localized: SON TUR!
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092482
    m_Localized: "{0} SAN\u0130YE"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092483
    m_Localized: TUR {0}
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092484
    m_Localized: "KOTA {0} \xB7 {1} TUR"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092485
    m_Localized: "SON TUR \xB7 KOTAYA {0} KALDI"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092486
    m_Localized: "SEV\u0130YE ATLADIN!"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092487
    m_Localized: Sv {0}
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092488
    m_Localized: "de\u011Fi\u015Fiklik yok"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092489
    m_Localized: "do\u011Frudan \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092490
    m_Localized: "davran\u0131\u015F \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092491
    m_Localized: "hasat kayna\u011F\u0131 \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092492
    m_Localized: "SINAMA GE\xC7\u0130LD\u0130 \xB7 UZMANLA\u015EMA SE\xC7"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092493
    m_Localized: "Birini se\xE7. {0}. turdan itibaren deneme sonuna kadar ge\xE7erli,
      geri al\u0131namaz."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092494
    m_Localized: "Art\u0131s\u0131 da eksisi de yok"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092495
    m_Localized: "Hasar ve hasat geliri oldu\u011Fu gibi kal\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092496
    m_Localized: "Do\u011Frudan hasar \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092497
    m_Localized: "Davran\u0131\u015F hasar\u0131 \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092498
    m_Localized: "patlama, kas\u0131rga, bumerang ve elektrik"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092499
    m_Localized: "Hasat kayna\u011F\u0131 \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092500
    m_Localized: "hasattan gelen Alt\u0131n, Demir ve Ta\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092501
    m_Localized: "SE\xC7"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092502
    m_Localized: SAKSICI
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092503
    m_Localized: "OLDU\u011EU G\u0130B\u0130 KALSIN"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092504
    m_Localized: TIRPANCI
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092505
    m_Localized: SAKSILAR
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092506
    m_Localized: "B\u0130R SAKSI SE\xC7"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092507
    m_Localized: "Saks\u0131n\u0131 se\xE7, tarlana yerle\u015Ftir."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092508
    m_Localized: "YETENEK A\u011EACI"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092509
    m_Localized: YOK
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092510
    m_Localized: "Katalogdan a\xE7\u0131k bir saks\u0131 se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092511
    m_Localized: SATIN AL
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092512
    m_Localized: '{0}x{1} SAKSI'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092513
    m_Localized: '{0} sn'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092514
    m_Localized: "{1} i\xE7in {0} ekim yeri."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092515
    m_Localized: "{0} bo\u015F, a\xE7\u0131k h\xFCcre gerekir. Yerle\u015Ftirirken
      R d\xF6nd\xFCr\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092516
    m_Localized: "s\u0131radaki \xFCr\xFCn\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092517
    m_Localized: SATIN AL  /  {0}
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092518
    m_Localized: "Bu saks\u0131 \u015Fu an sat\u0131n al\u0131nam\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092519
    m_Localized: "Bu saks\u0131y\u0131 yetenek a\u011Fac\u0131nda a\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092520
    m_Localized: 'Mevcut: {0} {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092521
    m_Localized: '{0} {1} daha gerekli  /  Mevcut: {2}'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092522
    m_Localized: Pancar
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092523
    m_Localized: "Havu\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092524
    m_Localized: "M\u0131s\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092525
    m_Localized: "\xDCz\xFCm"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092526
    m_Localized: "\xC7imen"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092527
    m_Localized: Marul
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092528
    m_Localized: Biber
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092529
    m_Localized: Ananas
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092530
    m_Localized: Patates
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092531
    m_Localized: "Balkaba\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092532
    m_Localized: "\xC7ilek"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092533
    m_Localized: Domates
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092534
    m_Localized: 'Hasat skoru: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092535
    m_Localized: "Ba\u015Flang\u0131\xE7: {0} \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725756092536
    m_Localized: "Kal\u0131c\u0131 olarak a\xE7\u0131ld\u0131: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286720
    m_Localized: "SINAMA \xD6D\xDCLLER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286721
    m_Localized: "S\u0131nama \xF6d\xFClleri: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286722
    m_Localized: "Aktif oynan\u0131\u015F {0} \xB7 se\xE7imler {1} \xB7 d\xFCkk\xE2n
      ve haz\u0131rl\u0131k {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286723
    m_Localized: seviye atlama {0}
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286724
    m_Localized: duraklama {0}
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286725
    m_Localized: KOTA VE SINAMA HASADI TUTMADI
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286726
    m_Localized: SINAMA HASADI TUTMADI
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286727
    m_Localized: "d\xF6nem kotas\u0131 {0} (eksik)"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286728
    m_Localized: "d\xF6nem kotas\u0131 {0} (tamam)"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286729
    m_Localized: "Tur {0} \xB7 S\u0131nama hasad\u0131 {1} (eksik) \xB7 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286730
    m_Localized: KOTA TUTMADI
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286731
    m_Localized: "Tur {0} \xB7 d\xF6nem skoru {1} (gereken kota)"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286732
    m_Localized: "S\u0131nama hasad\u0131 {0} / {1} (tamam)"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286733
    m_Localized: DENEME TAMAMLANDI
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286734
    m_Localized: son kota {0}
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286735
    m_Localized: '{0} tur'
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286736
    m_Localized: DENEME TAMAMLANDI
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286737
    m_Localized: DENEME TAMAMLANDI
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286738
    m_Localized: DEMO TAMAMLANDI!
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286739
    m_Localized: "\u0130K\u0130 YOL"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286740
    m_Localized: "\u0130ki b\xF6lgeden biri kapanacak. Hangi d\xFC\u011F\xFCm\xFC
      k\u0131rarsan onun b\xF6lgesi kurtulur. Hi\xE7birini k\u0131rmazsan A kapan\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286741
    m_Localized: "Se\xE7: A d\xFC\u011F\xFCm\xFC {0}/{1} \xB7 B d\xFC\u011F\xFCm\xFC
      {2}/{3} \xB7 {4} sn sonra A kapan\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286742
    m_Localized: "{0} kurtuldu \xB7 {1} b\xF6lgesinde \xFCretim durdu \xB7 {2} sn"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286743
    m_Localized: "{0} b\xF6lgesi a\xE7\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286744
    m_Localized: "K\u0131rd\u0131\u011F\u0131n d\xFC\u011F\xFCm\xFCn b\xF6lgesi kurtulur"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286745
    m_Localized: "A d\xFC\u011F\xFCm\xFC {0}/{1} \xB7 B d\xFC\u011F\xFCm\xFC {2}/{3}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286746
    m_Localized: "{0} sn sonra A kapan\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286747
    m_Localized: "Se\xE7mezsen A kapan\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286748
    m_Localized: "\u0130ST\u0130LACI F\u0130L\u0130Z"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286749
    m_Localized: "Bir filiz \xE7\u0131k\u0131yor. Yay\u0131ld\u0131\u011F\u0131 h\xFCcrelerde
      \xFCretim yava\u015Flar. Ana filizi kendi vuru\u015Funla k\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286750
    m_Localized: "\xDCretim yava\u015F: {0} h\xFCcre \xB7 ana filiz {1}/{2} \xB7
      {3} sn"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286751
    m_Localized: "Ana filizi k\u0131rd\u0131n, \xFCretim normale d\xF6nd\xFC."
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286752
    m_Localized: "Filiz kurudu, \xFCretim normale d\xF6nd\xFC."
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286753
    m_Localized: "D\u0130KEN KU\u015EATMASI"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286754
    m_Localized: "\u0130\u015Faretli {0} h\xFCcrede \xFCretim duracak. K\xF6kleri
      kendi vuru\u015Funla k\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286755
    m_Localized: "B\xF6lgede \xFCretim durdu \xB7 kalan k\xF6k {0}/{1} \xB7 {2} sn"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286756
    m_Localized: "K\xF6kleri k\u0131rd\u0131n, b\xF6lge a\xE7\u0131ld\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286757
    m_Localized: "Dikenler \xE7ekildi, b\xF6lge a\xE7\u0131ld\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286758
    m_Localized: "GEZG\u0130N BEREKET"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286759
    m_Localized: "Bereket geliyor: kaynak ve TP iki kat\u0131, \xFCretim iki kat
      h\u0131zl\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286760
    m_Localized: "Kaynak \xD72 \xB7 TP \xD72"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286761
    m_Localized: "Tur boyunca bo\u015F yuvalar iki kat h\u0131zl\u0131 dolar"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286762
    m_Localized: "{0} bereketli hasat \xB7 {1} h\u0131zl\u0131 do\u011Fu\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286763
    m_Localized: 'Bereket bitti: {0} bereketli hasat'
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286764
    m_Localized: "{0} h\u0131zl\u0131 do\u011Fu\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286765
    m_Localized: "SATI\u015ETAN \xC7IK"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286766
    m_Localized: "GER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286767
    m_Localized: ERKEN
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286768
    m_Localized: ORTA
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286769
    m_Localized: "G\xDC\xC7L\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 229169762684928
    m_Localized: "K\u0130L\u0130TL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 298375912902656
    m_Localized: "Bir S\u0131namay\u0131 ge\xE7tin! Sevin\xE7ten yapraklar\u0131m
      titriyor."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845696
    m_Localized: "Senin gemin nereden gelmi\u015Fti? D\xFCnya m\u0131? H\u0131mm\u2026
      hi\xE7 duymad\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845697
    m_Localized: "Peki, \xF6yle olsun."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845698
    m_Localized: "Bana g\xFCvendi\u011Fin i\xE7in te\u015Fekk\xFCr ederim."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845699
    m_Localized: Emin misin?
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845700
    m_Localized: "I\u0131\u0131mm\u2026 D\xFCnya, D\xFCnya\u2026 belki duymu\u015Fumdur,
      bilmem ki."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845701
    m_Localized: "Ama \xE7ok da g\xFC\xE7lenme, olur mu? G\xFC\xE7l\xFC \xE7ift\xE7iler
      bir g\xFCn hep \xE7ekip gidiyor."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845702
    m_Localized: "Bu \xF6d\xFCl\xFC sana tarla verdi. Bence tarla seni \xE7ok sevdi."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845703
    m_Localized: "Ben de seni sevdim. Senin gibi \xE7al\u0131\u015Fkan ellere ihtiyac\u0131m
      var."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845704
    m_Localized: "Be\u015F tur oldu bile! Fena de\u011Filsin, \xE7ift\xE7i."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845705
    m_Localized: "Sen \xE7al\u0131\u015Ft\u0131k\xE7a ben b\xFCy\xFCyorum. Bence
      ikimiz i\xE7in de iyi bir anla\u015Fma."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845706
    m_Localized: "Ada\u011F\u0131 neden mi istiyorum? B\xFCy\xFCmek i\xE7in tabii
      ki."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845707
    m_Localized: "Sen bana ne kadar verirsen ben o kadar b\xFCy\xFCr\xFCm. Sen de
      b\xFCy\xFCmek istiyorsun, biliyorum."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845708
    m_Localized: "Senden \xF6nce de \xE7ift\xE7iler geldi. Hepsi \xE7ok \xE7al\u0131\u015Fkand\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845709
    m_Localized: "Sonra\u2026 gittiler. Evet, hepsi gitti."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845710
    m_Localized: "Gemin neden d\xFC\u015Ft\xFC, hi\xE7 d\xFC\u015F\xFCnd\xFCn m\xFC?
      Yak\u0131t\u0131n vard\u0131, motorun da sa\u011Flamd\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845711
    m_Localized: "Neyse, bo\u015F ver bunu. Burada mutlusun i\u015Fte."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845712
    m_Localized: "Bu kadar ileri gidece\u011Fini hi\xE7 d\xFC\u015F\xFCnmemi\u015Ftim\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845713
    m_Localized: "Biraz soldum, fark ettin mi? Sen g\xFC\xE7lendik\xE7e korkmaya
      ba\u015Flad\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845714
    m_Localized: "Seninle biraz daha oynamak isterdim. Ama yak\u0131nda soru sormaya
      ba\u015Flayacaks\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845715
    m_Localized: Ne sorusu?
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845716
    m_Localized: "Hi\xE7. Sen hasad\u0131na bakmal\u0131s\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845717
    m_Localized: Soru sormam.
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845718
    m_Localized: "Hep b\xF6yle dersiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845719
    m_Localized: "Eskiden kocaman, mavi bir tarlam vard\u0131. \xC7ekirde\u011Fi
      s\u0131cac\u0131kt\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845720
    m_Localized: "Hepsini yedim. Mmm\u2026 tad\u0131 h\xE2l\xE2 dama\u011F\u0131mda."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845721
    m_Localized: "\xD6nceki \xE7ift\xE7iler gitmedi. Onlar\u0131 ben hasat ettim."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845722
    m_Localized: "Bana k\u0131zacaks\u0131n. Hepsi k\u0131zm\u0131\u015Ft\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845723
    m_Localized: "Gemiler kendi kendine d\xFC\u015Fmez. Seninkini ben a\u015Fa\u011F\u0131
      \xE7ektim."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845724
    m_Localized: "Ellerine ihtiyac\u0131m vard\u0131. H\xE2l\xE2 var."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845725
    m_Localized: "Mavi tarlan\u0131n bir ad\u0131 vard\u0131. Senin gemin oradan
      kalkt\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845726
    m_Localized: "Art\u0131k biliyorsun, de\u011Fil mi?"
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845727
    m_Localized: "Bu son S\u0131nama. Ge\xE7ersen beni yenmi\u015F olacaks\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845728
    m_Localized: "Ge\xE7emezsen yine burada kalacaks\u0131n. \u0130ki t\xFCrl\xFC
      de ben kazan\u0131r\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845729
    m_Localized: "Kazand\u0131n. Sonuna kadar geldin\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845730
    m_Localized: "O zaman oyun bitti. Art\u0131k saklanmama gerek yok."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845731
    m_Localized: "Evet. D\xFCnya'n\u0131n \xE7ekirde\u011Fini ben yedim. Gemini de
      ben d\xFC\u015F\xFCrd\xFCm."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845732
    m_Localized: "Bana g\xFCvendin. En \xE7ok da bunu sevdim."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845733
    m_Localized: "Benden \u015F\xFCphelendin, hakl\u0131yd\u0131n da. Ama yine de
      kald\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845734
    m_Localized: "Hi\xE7 \xFCz\xFClmedim, \xE7ift\xE7i. Sadece a\xE7t\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845735
    m_Localized: "Hadi, hasada devam et. Bir sonraki gezegen i\xE7in g\xFC\xE7lenmem
      laz\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845736
    m_Localized: "Art\u0131k birbirimizi tan\u0131yoruz. Hadi, Ada\u011F\u0131m seni
      bekliyor."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845737
    m_Localized: "Ka\xE7amazs\u0131n. Ne gemin var ne de D\xFCnya'n. Burada bir tek
      ben var\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 530164191350784
    m_Localized: TUR
    m_Metadata:
      m_Items: []
  - m_Id: 530164224905216
    m_Localized: '{0} / {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2315510637940736
    m_Localized: AL
    m_Metadata:
      m_Items: []
  - m_Id: 2317584742240256
    m_Localized: '{0} {1} eksik'
    m_Metadata:
      m_Items: []
  - m_Id: 2473096205062144
    m_Localized: ERIGONE
    m_Metadata:
      m_Items: []
  - m_Id: 2714466735902720
    m_Localized: "Kartlar\u0131 Ge\xE7 ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 5609442599784448
    m_Localized: "S\u0131nama \xF6d\xFClleri ({0}) \xB7 {1} ile g\xF6ster"
    m_Metadata:
      m_Items: []
  - m_Id: 5609442645921792
    m_Localized: "S\u0131nama \xF6d\xFClleri ({0}) \xB7 {1} ile gizle"
    m_Metadata:
      m_Items: []
  - m_Id: 5622503402393600
    m_Localized: '{0} ({1})'
    m_Metadata:
      m_Items: []
  - m_Id: 5622503410782208
    m_Localized: "D\u0130\u011EER"
    m_Metadata:
      m_Items: []
  - m_Id: 5627776087117824
    m_Localized: "\xD6nizleme / S\u0131nama \xD6d\xFClleri"
    m_Metadata:
      m_Items: []
  - m_Id: 5627776108089344
    m_Localized: "Turlar aras\u0131nda tur \xF6nizlemesini a\xE7ar. Tur s\u0131ras\u0131nda
      kota kart\u0131ndaki S\u0131nama \xF6d\xFClleri listesini a\xE7\u0131p kapat\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 6318183146082304
    m_Localized: "T\xFCm Sesler"
    m_Metadata:
      m_Items: []
  - m_Id: 6318183179636736
    m_Localized: "B\xFCt\xFCn sesleri a\xE7ar ya da kapat\u0131r. Ses d\xFCzeylerin
      oldu\u011Fu gibi kal\u0131r. Haz\u0131rl\u0131k ekran\u0131ndaki hoparl\xF6r
      d\xFC\u011Fmesiyle ayn\u0131 ayar."
    m_Metadata:
      m_Items: []
  - m_Id: 6318183192219648
    m_Localized: "DENEME B\u0130TT\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 6318183192219649
    m_Localized: HASAT SKORU
    m_Metadata:
      m_Items: []
  - m_Id: 6318183192219650
    m_Localized: "ULA\u015EILAN TUR"
    m_Metadata:
      m_Items: []
  - m_Id: 6318183192219651
    m_Localized: "SINAMA \xD6D\xDCL\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 6318183192219652
    m_Localized: "AKT\u0130F S\xDCRE"
    m_Metadata:
      m_Items: []
  - m_Id: 6318918508236800
    m_Localized: ZAFER!
    m_Metadata:
      m_Items: []
  - m_Id: 6318918520819712
    m_Localized: "SEN\u0130 DURDURAN"
    m_Metadata:
      m_Items: []
  - m_Id: 6318918520819713
    m_Localized: SON KOTA
    m_Metadata:
      m_Items: []
  - m_Id: 6318918520819714
    m_Localized: KOTA
    m_Metadata:
      m_Items: []
  - m_Id: 6318918520819715
    m_Localized: SINAMA HASADI
    m_Metadata:
      m_Items: []
  - m_Id: 6322087216828416
    m_Localized: "T\xDCM KOTALAR TUTTU"
    m_Metadata:
      m_Items: []
  - m_Id: 6861648518991872
    m_Localized: "Kapal\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 6861648544157696
    m_Localized: Sabit
    m_Metadata:
      m_Items: []
  - m_Id: 6861648544157697
    m_Localized: "G\xFCce G\xF6re"
    m_Metadata:
      m_Items: []
  - m_Id: 7052901512663040
    m_Localized: "B\u0130R KART SE\xC7"
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606080
    m_Localized: "Kart, tarlaya yeni bir parsel koyar. Parsel, \xFCst\xFCne koydu\u011Fun
      saks\u0131y\u0131 g\xFC\xE7lendirir."
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606085
    m_Localized: "\xDCst\xFCndeki saks\u0131 bitkileri daha s\u0131k \xE7\u0131kar\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606086
    m_Localized: "\xDCst\xFCndeki saks\u0131n\u0131n bitkilerinden daha \xE7ok TP
      gelir."
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606087
    m_Localized: "\xDCst\xFCndeki saks\u0131dan nadir bitki \xE7\u0131kma \u015Fans\u0131
      artar."
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606088
    m_Localized: "\xDCst\xFCndeki saks\u0131n\u0131n bitkileri daha \xE7ok hasat
      skoru verir."
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606089
    m_Localized: "\xDCst\xFCndeki saks\u0131n\u0131n bitkisi hasat edilince bazen
      patlar ve \xE7evresine vurur."
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606090
    m_Localized: "\xDCst\xFCndeki saks\u0131n\u0131n bitkisini hasat edince \xF6d\xFCl
      bazen iki kat gelir."
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606091
    m_Localized: "\xDCst\xFCndeki saks\u0131n\u0131n bitkilerine do\u011Frudan vuru\u015Fun
      daha \xE7ok hasar verir."
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606092
    m_Localized: "\xDCst\xFCndeki saks\u0131n\u0131n bitkisi hasat edilince bazen
      tarlada dola\u015Fan bir kas\u0131rga \xE7\u0131kar."
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606093
    m_Localized: "\xDCst\xFCndeki saks\u0131n\u0131n bitkisi hasat edilince bazen
      gidip geri d\xF6nen bir orak f\u0131rlar."
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606094
    m_Localized: "\xDCst\xFCndeki saks\u0131n\u0131n bitkisi hasat edilince bazen
      \xE7apraz y\xF6nlere elektrik s\u0131\xE7rar."
    m_Metadata:
      m_Items: []
  - m_Id: 7052901554606095
    m_Localized: "\xDCretim zaten en h\u0131zl\u0131da. Fazla h\u0131z nadirli\u011Fe
      d\xF6n\xFC\u015F\xFCr."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
