      m_Items: []
  - m_Id: 227725760286724
    m_Localized: duraklama {0}
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286725
    m_Localized: KOTA VE BOSS HASADI TUTMADI
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286726
    m_Localized: BOSS HASADI TUTMADI
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286727
    m_Localized: "segment kotas\u0131 {0} (eksik)"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286728
    m_Localized: "segment kotas\u0131 {0} (tamam)"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286729
    m_Localized: "Round {0} \xB7 boss hasad\u0131 {1} (eksik) \xB7 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286730
    m_Localized: KOTA TUTMADI
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286731
    m_Localized: "Round {0} \xB7 segment skoru {1} (gereken kota)"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286732
    m_Localized: "boss hasad\u0131 {0} / {1} (tamam)"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286733
    m_Localized: RUN TAMAMLANDI
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286734
    m_Localized: son kota {0}
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286735
    m_Localized: '{0} round'
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286736
    m_Localized: "RUN TAMAMLANDI \xB7 ALPHA DENGE V1"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286737
    m_Localized: "RUN TAMAMLANDI \xB7 GE\xC7 OYUN V1"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286738
    m_Localized: DEMO TAMAMLANDI!
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286739
    m_Localized: "A\u015EILI KABUK"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286740
    m_Localized: "\u0130ki b\xF6lgeden biri kapanacak \xB7 bir d\xFC\u011F\xFCm\xFC
      k\u0131r: onun b\xF6lgesi kurtulur, di\u011Feri kapan\u0131r \xB7 se\xE7mezsen
      A kapan\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286741
    m_Localized: "Se\xE7: A d\xFC\u011F\xFCm\xFC {0}/{1} \xB7 B d\xFC\u011F\xFCm\xFC
      {2}/{3} \xB7 {4} sn sonra A kapan\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286742
    m_Localized: "{0} kurtuldu \xB7 {1} b\xF6lgesinde \xFCretim durdu \xB7 {2} sn"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286743
    m_Localized: "{0} b\xF6lgesi a\xE7\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286744
    m_Localized: "K\u0131rd\u0131\u011F\u0131n d\xFC\u011F\xFCm\xFCn b\xF6lgesi kurtulur"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286745
    m_Localized: "A d\xFC\u011F\xFCm\xFC {0}/{1} \xB7 B d\xFC\u011F\xFCm\xFC {2}/{3}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286746
    m_Localized: "{0} sn sonra A kapan\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286747
    m_Localized: "Se\xE7mezsen A kapan\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286748
    m_Localized: "\u0130ST\u0130LACI F\u0130L\u0130Z"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286749
    m_Localized: "Filiz \xE7\u0131k\u0131yor \xB7 yay\u0131ld\u0131\u011F\u0131 h\xFCcrelerde
      \xFCretim yava\u015Flar \xB7 ana filizi kendi vuru\u015Funla k\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286750
    m_Localized: "\xDCretim yava\u015F: {0} h\xFCcre \xB7 ana filiz {1}/{2} \xB7
      {3} sn"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286751
    m_Localized: "Ana filiz k\u0131r\u0131ld\u0131 \xB7 \xFCretim normale d\xF6nd\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286752
    m_Localized: "Filiz kurudu \xB7 \xFCretim normale d\xF6nd\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286753
    m_Localized: "D\u0130KEN KU\u015EATMASI"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286754
    m_Localized: "\u0130\u015Faretli {0} h\xFCcrede \xFCretim duracak \xB7 k\xF6kleri
      kendi vuru\u015Funla k\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286755
    m_Localized: "B\xF6lgede \xFCretim durdu \xB7 kalan k\xF6k {0}/{1} \xB7 {2} sn"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286756
    m_Localized: "K\xF6kler k\u0131r\u0131ld\u0131 \xB7 b\xF6lge a\xE7\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286757
    m_Localized: "Dikenler \xE7ekildi \xB7 b\xF6lge a\xE7\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286758
    m_Localized: "GEZG\u0130N BEREKET"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286759
    m_Localized: "Bereket geliyor: kaynak ve XP \xD72 \xB7 \xFCretim \xD72 h\u0131zl\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286760
    m_Localized: "Kaynak \xD72 \xB7 XP \xD72"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286761
    m_Localized: "Bo\u015F yuvalar \xD72 h\u0131zl\u0131 dolar \xB7 round boyunca"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286762
    m_Localized: "{0} bereketli hasat \xB7 {1} h\u0131zl\u0131 do\u011Fu\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286763
    m_Localized: "Bereket bitti \xB7 {0} bonuslu hasat"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286764
    m_Localized: "{0} h\u0131zl\u0131 do\u011Fu\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286765
    m_Localized: "SATI\u015ETAN \xC7IK"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286766
    m_Localized: "GER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286767
    m_Localized: ERKEN
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286768
    m_Localized: ORTA
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286769
    m_Localized: "G\xDC\xC7L\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 229169762684928
    m_Localized: "K\u0130L\u0130TL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 298375912902656
    m_Localized: "Bir S\u0131nama'y\u0131 ge\xE7tin! K\xF6klerime kadar bir titreme
      indi."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845696
    m_Localized: "Gemin nereden geliyordu? D\xFCnya m\u0131? \u2026Hi\xE7 duymad\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845697
    m_Localized: "Peki, \xF6yle olsun."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845698
    m_Localized: "Bana g\xFCvendi\u011Fin i\xE7in sa\u011F ol."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845699
    m_Localized: Emin misin?
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845700
    m_Localized: "I\u0131\u0131mm\u2026 D\xFCnya, D\xFCnya\u2026 belki duymu\u015Fumdur,
      bilmem ki."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845701
    m_Localized: "\xC7ok g\xFC\xE7lenme ama\u2026 G\xFC\xE7l\xFC \xE7ift\xE7iler
      bir g\xFCn hep gider."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845702
    m_Localized: "O \xF6d\xFCl\xFC sana tarla verdi. Tarla seni seviyor."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845703
    m_Localized: "Ben de seviyorum. G\xFC\xE7l\xFC eller \xE7ok k\u0131ymetli."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845704
    m_Localized: "Be\u015F round oldu bile! Fena de\u011Filsin, \xE7ift\xE7i."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845705
    m_Localized: "Sen \xE7al\u0131\u015Ft\u0131k\xE7a ben b\xFCy\xFCr\xFCm. Adil
      bir anla\u015Fma, de\u011Fil mi?"
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845706
    m_Localized: "Adak'\u0131 neden mi istiyorum? B\xFCy\xFCmek i\xE7in."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845707
    m_Localized: "Ne kadar \xE7ok verirsen o kadar b\xFCy\xFCr\xFCm. Sen de b\xFCy\xFCmek
      istemez misin?"
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845708
    m_Localized: "Senden \xF6nce de \xE7ift\xE7iler geldi. Hepsi \xE7ok \xE7al\u0131\u015Fkand\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845709
    m_Localized: "Sonra\u2026 gittiler. Evet. Gittiler."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845710
    m_Localized: "Gemin neden d\xFC\u015Ft\xFC, hi\xE7 d\xFC\u015F\xFCnd\xFCn m\xFC?
      Yak\u0131t\u0131n vard\u0131, motorun sa\u011Flamd\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845711
    m_Localized: "\u2026Bo\u015F ver. Burada mutlusun, de\u011Fil mi?"
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845712
    m_Localized: "Bu kadar uza\u011Fa gelece\u011Fini d\xFC\u015F\xFCnmemi\u015Ftim\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845713
    m_Localized: "Biraz soldum, de\u011Fil mi? Sen g\xFC\xE7lendik\xE7e ben korkuyorum."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845714
    m_Localized: "Seninle biraz daha oynamak isterdim. Ama yak\u0131nda soru sormaya
      ba\u015Flars\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845715
    m_Localized: Ne sorusu?
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845716
    m_Localized: "\u2026Bo\u015F ver. Hasat et."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845717
    m_Localized: Soru sormam.
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845718
    m_Localized: "Hep b\xF6yle dersiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845719
    m_Localized: "Eskiden mavi, kocaman bir tarlam vard\u0131. Topra\u011F\u0131
      \xE7ekirde\u011Fine kadar s\u0131cakt\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845720
    m_Localized: "Onu bitirdim. Tad\u0131 h\xE2l\xE2 dama\u011F\u0131mda."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845721
    m_Localized: "\xD6nceki \xE7ift\xE7iler gitmedi. Ben onlar\u0131\u2026 hasat
      ettim."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845722
    m_Localized: "Bana k\u0131zacaks\u0131n. Hepsi k\u0131zm\u0131\u015Ft\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845723
    m_Localized: "Gemiler kendili\u011Finden d\xFC\u015Fmez. Senin gemini ben \xE7ektim."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845724
    m_Localized: "Ellerine ihtiyac\u0131m vard\u0131. H\xE2l\xE2 var."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845725
    m_Localized: "Mavi tarlan\u0131n bir ad\u0131 vard\u0131. Senin gemin oradan
      kalkt\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845726
    m_Localized: "Art\u0131k biliyorsun, de\u011Fil mi?"
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845727
    m_Localized: "Son S\u0131nama. Ge\xE7ersen beni yenmi\u015F olursun."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845728
    m_Localized: "Ge\xE7emezsen yine buradas\u0131n. \u0130kisi de benim i\u015Fime
      yarar."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845729
    m_Localized: "Kazand\u0131n. Sona geldin\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845730
    m_Localized: "O zaman oyun bitti. Saklanmama gerek kalmad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845731
    m_Localized: "Evet. D\xFCnya'n\u0131n \xE7ekirde\u011Fini ben yedim. Gemini de
      ben d\xFC\u015F\xFCrd\xFCm."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845732
    m_Localized: "Bana g\xFCvenmi\u015Ftin. En tatl\u0131s\u0131 buydu."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845733
    m_Localized: "Benden \u015F\xFCphelenmi\u015Ftin. Hakl\u0131yd\u0131n, ama yine
      de kald\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845734
    m_Localized: "\xDCzg\xFCn de\u011Fildim, \xE7ift\xE7i. Hi\xE7 olmad\u0131m. Sadece
      a\xE7t\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845735
    m_Localized: "Hasat et. Bir sonraki gezegen i\xE7in g\xFC\xE7lenmem laz\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845736
    m_Localized: "Art\u0131k birbirimizi tan\u0131yoruz. Adak'\u0131m bekliyor."
    m_Metadata:
      m_Items: []
  - m_Id: 298375954845737
    m_Localized: "Ka\xE7amazs\u0131n. Gemin yok, D\xFCnya'n yok. Sadece ben var\u0131m."
    m_Metadata:
      m_Items: []
