  - m_Id: 158100922060821
    m_Localized: Standart
    m_Metadata:
      m_Items: []
  - m_Id: 158100922060822
    m_Localized: "Mevcut vuru\u015F: hasar ve yar\u0131\xE7ap oldu\u011Fu gibi."
