    m_Localized: "Bo\u015F parsel"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219819
    m_Localized: "Bu turun kart\u0131 bu parseli y\xFCkseltti."
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219820
