      m_Items: []
  - m_Id: 161690705219710
    m_Localized: "\xC7apraz elektrik \u015Fans\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219711
    m_Localized: "EN \xDCST SEV\u0130YEDE"
