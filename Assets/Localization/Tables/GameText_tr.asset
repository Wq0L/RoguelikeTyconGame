  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: GameText_tr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 8b2906cf59e79cc4c9072b57e0d27f17, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 936136704
    m_Localized: 1
    m_Metadata:
      m_Items: []
  - m_Id: 965496832
    m_Localized: Eri
    m_Metadata:
      m_Items: []
  - m_Id: 969691136
    m_Localized: Atla
    m_Metadata:
      m_Items: []
  - m_Id: 969691137
    m_Localized: "Aa, bir gemi! Uzun zamand\u0131r buraya kimse d\xFC\u015Fmemi\u015Fti.
      Pardon, gelmemi\u015Fti demek istedim."
    m_Metadata:
      m_Items: []
  - m_Id: 969691138
    m_Localized: "Ben Eri, bu gezegen de benim. Burada kalacaksan tarlam\u0131 sen
      ekip bi\xE7eceksin, anla\u015Ft\u0131k m\u0131?"
    m_Metadata:
      m_Items: []
  - m_Id: 969691139
    m_Localized: "\xD6nce bir \xE7ift\xE7i ve bir t\u0131rpan se\xE7melisin. Gerisini
      birlikte hallederiz."
    m_Metadata:
      m_Items: []
  - m_Id: 969691140
    m_Localized: "Tarla bombo\u015F! \xD6nce d\xFCkk\xE2ndan bir saks\u0131 almal\u0131s\u0131n,
      sonra turu ba\u015Flatabilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 969691141
    m_Localized: "Saks\u0131y\u0131 koymak i\xE7in bo\u015F bir yere t\u0131klamal\u0131s\u0131n.
      R tu\u015Fuyla da d\xF6nd\xFCrebilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 969691142
    m_Localized: "Hasat etmeyi bilmiyor musun? \u0130mleci bitkilerin \xFCst\xFCnde
      tutman yeterli, t\u0131rpan kendisi vurur."
    m_Metadata:
      m_Items: []
  - m_Id: 969691143
    m_Localized: "Hmm, D\xFCnya'da otomatik t\u0131rpan yok mu? Ben var san\u0131yordum."
    m_Metadata:
      m_Items: []
  - m_Id: 969691144
    m_Localized: "Sol \xFCstteki pay benim Ada\u011F\u0131m. D\xF6nem bitmeden onu
      doldurmal\u0131s\u0131n, tamam m\u0131?"
    m_Metadata:
      m_Items: []
  - m_Id: 969691145
    m_Localized: "Seviye atlad\u0131n! \u015Eimdi bir kart se\xE7melisin, deneme
      bitene kadar seninle kalacak."
    m_Metadata:
      m_Items: []
  - m_Id: 969691146
    m_Localized: "Bu d\xF6nemin son turu ve Ada\u011F\u0131m h\xE2l\xE2 eksik. Acele
      etmelisin!"
    m_Metadata:
      m_Items: []
  - m_Id: 969691147
    m_Localized: "Mmm\u2026 doydum."
    m_Metadata:
      m_Items: []
  - m_Id: 969691148
    m_Localized: "\u015Eimdilik doydum. Ama bir dahaki sefere daha fazlas\u0131n\u0131
      isteyece\u011Fim."
    m_Metadata:
      m_Items: []
  - m_Id: 969691149
    m_Localized: "Bu tur bir S\u0131nama! Soldaki hedefi tur bitmeden doldurmal\u0131s\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 969691150
    m_Localized: "Tohumlar\u0131mdan biri azd\u0131! Ne yapt\u0131\u011F\u0131n\u0131
      soldaki yaz\u0131dan okuyabilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 969691151
    m_Localized: "Ada\u011F\u0131m\u0131 dolduramad\u0131n. Ben a\xE7 bekleyemem."
    m_Metadata:
      m_Items: []
  - m_Id: 969691152
    m_Localized: "Neyse, ba\u015Ftan ba\u015Flar\u0131z. Ben bir yere gitmiyorum."
    m_Metadata:
      m_Items: []
  - m_Id: 969691153
    m_Localized: "S\u0131namay\u0131 ge\xE7emedin. Ben de daha fazla bekleyemem."
    m_Metadata:
      m_Items: []
  - m_Id: 969691154
    m_Localized: Ama yine geleceksin, biliyorum.
    m_Metadata:
      m_Items: []
  - m_Id: 969691155
    m_Localized: "Mmm! Doydum. Bu sefer ger\xE7ekten doydum."
    m_Metadata:
      m_Items: []
  - m_Id: 969691156
    m_Localized: "Ama bu tokluk \xE7ok s\xFCrmez."
    m_Metadata:
      m_Items: []
  - m_Id: 969691157
    m_Localized: "Hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 969691158
    m_Localized: "Mmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 148337693839360
    m_Localized: "TEMEL \u2192 KARTLA  \xB7  \xD6RNEK"
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393792
    m_Localized: "PARSEL ETK\u0130S\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393793
    m_Localized: "Ana Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393794
    m_Localized: 1x1 SAKSI
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393795
    m_Localized: 1x2 SAKSI
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393796
    m_Localized: 1x3 SAKSI
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393797
    m_Localized: 2x2 SAKSI
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393798
    m_Localized: 2x3 SAKSI
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393799
    m_Localized: "TEM\u0130ZLE"
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393800
    m_Localized: "B\xDCY\xDCME S\xDCRES\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393801
    m_Localized: "EK\u0130M YER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393802
    m_Localized: SAT
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393803
    m_Localized: BOYUT
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393804
    m_Localized: "SAKSI D\xDCKK\xC2NI"
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393805
    m_Localized: "Yeniden Ba\u015Fla<br>"
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393806
    m_Localized: "YETENEK D\xDCKK\xC2NI"
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393807
    m_Localized: Atla
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393808
    m_Localized: "TURU BA\u015ELAT"
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393809
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393810
    m_Localized: Oyna<br>
    m_Metadata:
      m_Items: []
  - m_Id: 148337727393811
    m_Localized: "\xC7\u0131k\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 151479529525248
    m_Localized: AYARLAR
    m_Metadata:
      m_Items: []
  - m_Id: 151479529525249
    m_Localized: "G\xD6R\xDCNT\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719552
    m_Localized: SES
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719553
    m_Localized: "OYNANI\u015E"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719554
    m_Localized: KONTROLLER
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719555
    m_Localized: VARSAYILANLAR
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719556
    m_Localized: "GER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719557
    m_Localized: "A\xC7IK"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719558
    m_Localized: KAPALI
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719559
    m_Localized: "Bir ayar\u0131n \xFCzerine gel, ne i\u015Fe yarad\u0131\u011F\u0131
      burada g\xF6r\xFCns\xFCn."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719560
    m_Localized: Dil / Language
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719561
    m_Localized: "Oyunun dili. \u0130lk a\xE7\u0131l\u0131\u015Fta bilgisayar\u0131n\u0131n
      dili se\xE7ilir, o dil yoksa \u0130ngilizce."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719562
    m_Localized: "\xC7\xF6z\xFCn\xFCrl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719563
    m_Localized: "Oyunun \xE7al\u0131\u015Ft\u0131\u011F\u0131 ekran \xE7\xF6z\xFCn\xFCrl\xFC\u011F\xFC."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719564
    m_Localized: Ekran Modu
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719565
    m_Localized: "Tam ekran, kenarl\u0131ks\u0131z pencere ya da normal pencere."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719566
    m_Localized: Tam Ekran
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719567
    m_Localized: "Kenarl\u0131ks\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719568
    m_Localized: Pencere
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719569
    m_Localized: VSync
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719570
    m_Localized: "G\xF6r\xFCnt\xFC y\u0131rt\u0131lmas\u0131n\u0131 \xF6nler ve FPS'i
      monit\xF6r\xFCn tazeleme h\u0131z\u0131na sabitler."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719571
    m_Localized: "FPS S\u0131n\u0131r\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719572
    m_Localized: "VSync kapal\u0131yken ge\xE7erli. D\xFC\u015F\xFCk s\u0131n\u0131r
      ekran kart\u0131n\u0131 ve pili rahatlat\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719573
    m_Localized: '{0} FPS'
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719574
    m_Localized: "S\u0131n\u0131rs\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719575
    m_Localized: Grafik Kalitesi
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719576
    m_Localized: "D\xFC\u015F\xFCk: zay\u0131f bilgisayarlar i\xE7in daha hafif g\xF6r\xFCnt\xFC
      ayarlar\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719577
    m_Localized: "D\xFC\u015F\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719578
    m_Localized: "Y\xFCksek"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719579
    m_Localized: Arka Plan Efektleri
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719580
    m_Localized: "Hareketli uzay arka plan\u0131. G\xFCce g\xF6re: sen g\xFC\xE7lendik\xE7e
      g\xF6ky\xFCz\xFC m\xFCzikle birlikte renk de\u011Fi\u015Ftirir. Sabit: g\xF6ky\xFCz\xFC
      hep ayn\u0131 kal\u0131r. Kapal\u0131: d\xFCz renk, zay\u0131f ekran kartlar\u0131nda
      FPS'i art\u0131r\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719581
    m_Localized: Ana Ses
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719582
    m_Localized: "Oyundaki t\xFCm seslerin genel seviyesi."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719583
    m_Localized: "M\xFCzik"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719584
    m_Localized: "M\xFCzik seviyesi."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719585
    m_Localized: Efektler
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719586
    m_Localized: "Hasat, vuru\u015F ve aray\xFCz efekt sesleri."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719587
    m_Localized: Arka Planda Sessiz
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719588
    m_Localized: "Ba\u015Fka bir pencereye ge\xE7ince oyunun sesini kapat\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719589
    m_Localized: "Ekran Sars\u0131nt\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719590
    m_Localized: "Patlama, kritik vuru\u015F ve tur sonu sars\u0131nt\u0131lar\u0131n\u0131n
      g\xFCc\xFC."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719591
    m_Localized: Kamera Hareketi
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719592
    m_Localized: "Kameran\u0131n hafif nefes alma hareketi."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719593
    m_Localized: "Hasar Yaz\u0131lar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719594
    m_Localized: "Vuru\u015Flarda \xE7\u0131kan hasar say\u0131lar\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719595
    m_Localized: "Tarla Koordinatlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719596
    m_Localized: "Tarla kenar\u0131ndaki A-K ve 1-11 etiketleri. Haritadaki koordinatlarla
      ayn\u0131d\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719597
    m_Localized: "Nadirlik Halkalar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719598
    m_Localized: "Bitkilerin alt\u0131ndaki, nadirli\u011Fini g\xF6steren renkli
      halka."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719599
    m_Localized: "Tur Sonu Yava\u015Flama"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719600
    m_Localized: "S\xFCre biterken zaman\u0131n k\u0131sa bir an yava\u015Flamas\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719601
    m_Localized: "Ekran Fla\u015Flar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719602
    m_Localized: "Tur sonundaki beyaz ekran fla\u015F\u0131. I\u015F\u0131\u011Fa
      hassassan kapat."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719603
    m_Localized: Hasat
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719604
    m_Localized: "\u0130mleci bitkilerin \xFCzerinde gezdir, t\u0131rpan kendili\u011Finden
      keser."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719605
    m_Localized: "\u0130MLE\xC7"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719606
    m_Localized: "Saks\u0131y\u0131 D\xF6nd\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719607
    m_Localized: "Yerle\u015Ftirme s\u0131ras\u0131nda saks\u0131y\u0131 d\xF6nd\xFCr\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719608
    m_Localized: "\u0130ptal / Geri"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719609
    m_Localized: "Yerle\u015Ftirmeyi iptal eder, d\xFCkk\xE2ndan ve sat\u0131\u015F
      modundan \xE7\u0131kar."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719610
    m_Localized: "Rezonans Detaylar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719611
    m_Localized: "Yerle\u015Ftirirken rezonans detay panelini a\xE7ar / kapat\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719612
    m_Localized: "Performans Kayd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719613
    m_Localized: "Performans kayd\u0131n\u0131 ba\u015Flat\u0131r / durdurur (oyun
      sahnesinde)."
    m_Metadata:
      m_Items: []
  - m_Id: 158100892700672
    m_Localized: '%{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866496
    m_Localized: "YEN\u0130 DENEME"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866497
    m_Localized: "Bir \xE7ift\xE7i ve bir t\u0131rpan se\xE7. Se\xE7imin bu deneme
      boyunca ge\xE7erli."
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866498
    m_Localized: "\xC7\u0130FT\xC7\u0130 \xB7 nas\u0131l oynayaca\u011F\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866499
    m_Localized: "TIRPAN \xB7 nas\u0131l kesece\u011Fin"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866500
    m_Localized: "GER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866501
    m_Localized: "DENEMEY\u0130 BA\u015ELAT"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866502
    m_Localized: "Se\xE7im: {0} + {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866503
    m_Localized: "SE\xC7\u0130L\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866504
    m_Localized: "Se\xE7mek i\xE7in t\u0131kla"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866505
    m_Localized: "K\u0130L\u0130TL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866506
    m_Localized: "K\u0130L\u0130TL\u0130 \xB7 G\xD6REV"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866507
    m_Localized: 'En iyi deneme: {0} / {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866508
    m_Localized: "Art\u0131s\u0131 da eksisi de yok"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866509
    m_Localized: "her \u015Fey oldu\u011Fu gibi"
    m_Metadata:
      m_Items: []
  - m_Id: 158100917866510
    m_Localized: "Do\u011Frudan vuru\u015F hasar\u0131 \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 158100922060800
    m_Localized: "davran\u0131\u015F hasar\u0131 de\u011Fi\u015Fmez"
    m_Metadata:
      m_Items: []
  - m_Id: 158100922060801
    m_Localized: "Hasat kayna\u011F\u0131 \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 158100922060802
    m_Localized: "sadece hasattan gelen Alt\u0131n, Demir ve Ta\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 158100922060803
    m_Localized: "Hasat skoru \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 158100922060804
    m_Localized: "kota ilerlemesi de bununla say\u0131l\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 158100922060805
    m_Localized: "Vuru\u015F yar\u0131\xE7ap\u0131 \xD7{0}"
    m_Metadata:
