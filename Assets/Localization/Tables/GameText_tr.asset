      m_Items: []
  - m_Id: 161690705219712
    m_Localized: KADEME  {0}
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219713
    m_Localized: "MEVCUT ETK\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219714
    m_Localized: "SONRAK\u0130 KADEME"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219715
    m_Localized: "Y\xDCKSELTME MAL\u0130YET\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219716
    m_Localized: "ER\u0130\u015E\u0130M"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219717
    m_Localized: "BA\u015ELANGI\xC7TAN A\xC7IK"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219718
    m_Localized: "TAM S\xDCR\xDCMDE"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219719
    m_Localized: "DEMO K\u0130L\u0130D\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219720
    m_Localized: "Bu \xF6zellik tam s\xFCr\xFCmde a\xE7\u0131l\u0131r. Demoda sat\u0131n
      al\u0131namaz."
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219721
    m_Localized: "Bu yetenek ba\u015Ftan a\xE7\u0131k, sat\u0131n alman gerekmez."
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219722
    m_Localized: "Bu modda tur s\xFCresi sabit: {0} sn."
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219723
    m_Localized: "Bu yetenek burada i\u015Fe yaramaz, sat\u0131n al\u0131namaz."
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219724
    m_Localized: Hasar
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219725
    m_Localized: "{0} \xB7 +{1} h\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219726
    m_Localized: "{0} (en h\u0131zl\u0131s\u0131, fazlas\u0131 nadirli\u011Fe d\xF6n\xFC\u015F\xFCr)"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219727
    m_Localized: "Destans\u0131+ {0} \xB7 Efsanevi {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219728
    m_Localized: "{0} saks\u0131 ba\u015Flang\u0131\xE7tan a\xE7\u0131k (d\xFCkk\xE2nda)."
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219729
    m_Localized: "{0} saks\u0131 d\xFCkk\xE2nda a\xE7\u0131k."
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219730
    m_Localized: "{0} saks\u0131y\u0131 d\xFCkk\xE2nda a\xE7ar."
