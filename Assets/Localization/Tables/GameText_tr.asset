    m_Metadata:
      m_Items: []
  - m_Id: 161690705219802
    m_Localized: "En h\u0131zl\u0131 \xFCretim \u2192 Nadirlik"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219803
    m_Localized: "\xD6zel etki"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219804
    m_Localized: "Temel g\xFC\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219805
    m_Localized: "Toplan\u0131r: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219806
    m_Localized: "TARLA DOLU \xB7 kart, se\xE7ti\u011Fin parseli y\xFCkseltir"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219807
    m_Localized: "B\xDCT\xDCN PARSELLER EN \xDCST SEV\u0130YEDE \xB7 kart kal\u0131c\u0131
      Temel g\xFC\xE7 verir"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219808
    m_Localized: "Hasat hasar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219809
    m_Localized: "Sald\u0131r\u0131 aral\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219810
    m_Localized: "\xDCretim s\xFCresi"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219811
    m_Localized: "T\xFCm kaynaklar"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219812
    m_Localized: "TP kazanc\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219813
    m_Localized: "SON SE\xC7\u0130M"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219814
    m_Localized: "KALAN SE\xC7\u0130M: {0}"
