  - m_Id: 227725751898117
    m_Localized: '{0} sn sonra'
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898118
    m_Localized: "her {0} do\u011Frudan hasatta bir: hasar \xD7{1}, yar\u0131\xE7ap
      \xD7{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898119
    m_Localized: "\u015Fans ve hasar {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898120
    m_Localized: "\u015Fans {0}, hasar {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898121
    m_Localized: "davran\u0131\u015F hasatlar\u0131 ba\u015Fka saks\u0131lar\u0131n
      davran\u0131\u015Flar\u0131n\u0131 da tetikler. En fazla {0} halka, her halkada
      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725751898122
    m_Localized: "Bir kez al\u0131n\u0131r"
