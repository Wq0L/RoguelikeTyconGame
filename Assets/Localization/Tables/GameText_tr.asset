    m_Localized: +{0} seviye
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219825
    m_Localized: "\xDCretim en h\u0131zl\u0131da ({0} sn). Fazla h\u0131z nadirli\u011Fe
      d\xF6n\xFC\u015Ft\xFC: saks\u0131ya {1} nadirlik."
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219826
    m_Localized: SAKSININ REZONANSLARI
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219827
    m_Localized: "BU KONUMDA A\xC7ILACAK"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219828
    m_Localized: "{0} parsel \xB7 {1} rezonans"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219829
    m_Localized: "{0}: a\xE7 / kapat"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219830
    m_Localized: "Bu konumda rezonans olu\u015Fmuyor."
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219831
    m_Localized: "SAKSININ ALTINDAK\u0130 PARSELLER"
    m_Metadata:
      m_Items: []
  - m_Id: 161690705219832
    m_Localized: "{0} / {1}: kayd\u0131r"
