    m_Metadata:
      m_Items: []
  - m_Id: 227725756092536
    m_Localized: "Kal\u0131c\u0131 olarak a\xE7\u0131ld\u0131: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286720
    m_Localized: "BOSS \xD6D\xDCLLER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286721
    m_Localized: "Boss \xF6d\xFClleri: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286722
    m_Localized: "Aktif oynan\u0131\u015F {0} \xB7 se\xE7imler {1} \xB7 ma\u011Faza
      ve haz\u0131rl\u0131k {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 227725760286723
