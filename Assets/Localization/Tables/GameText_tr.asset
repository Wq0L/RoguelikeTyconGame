      m_Items: []
  - m_Id: 227725751898114
    m_Localized: "patlaman\u0131n d\u0131\u015F\u0131na {0} h\xFCcre yay\u0131l\u0131r.
      Her ad\u0131m {1} sn s\xFCrer, ilk patlaman\u0131n {2} hasar\u0131n\u0131 verir"
