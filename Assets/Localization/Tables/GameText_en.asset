    m_Metadata:
      m_Items: []
  - m_Id: 151479533719569
    m_Localized: VSync
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719570
    m_Localized: Prevents screen tearing and locks the FPS to the monitor's refresh
      rate.
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719571
    m_Localized: FPS Limit
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719572
    m_Localized: Only when VSync is off. A lower limit eases the graphics card and
      the battery.
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719573
    m_Localized: '{0} FPS'
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719574
