    m_Metadata:
      m_Items: []
  - m_Id: 151479533719595
    m_Localized: Grid Coordinates
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719596
    m_Localized: "A\u2013K / 1\u201311 labels on the grid edge; the same as on the
      map."
    m_Metadata:
      m_Items: []
