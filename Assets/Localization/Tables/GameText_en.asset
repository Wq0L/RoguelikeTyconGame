    m_Metadata:
      m_Items: []
  - m_Id: 151479533719564
    m_Localized: Window Mode
    m_Metadata:
      m_Items: []
  - m_Id: 151479533719565
    m_Localized: Fullscreen, borderless window or a normal window.
